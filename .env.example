# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# The backend fails fast at startup with a named-key error if a required key is
# missing and MEANDER_STRICT_STARTUP=1.

# --- Required for live routing -------------------------------------------
# https://www.graphhopper.com/  ->  Dashboard  ->  API keys
# Free tier: 500 credits/day. One /api/routes request costs roughly 3 credits.
GRAPHHOPPER_KEY=

# --- Required for CLIP scenery scoring (offline batch job only) -----------
# https://www.mapillary.com/dashboard/developers  ->  create a client token
MAPILLARY_TOKEN=

# --- Optional: route narration -------------------------------------------
# https://console.anthropic.com/  ->  API keys. Costs real money per call.
# Absent -> narration is null and the app degrades silently.
ANTHROPIC_API_KEY=

# --- Optional: barrier reporting -----------------------------------------
# OAuth 2.0 token for api06.dev.openstreetmap.org ONLY — the OSM *development*
# server. Never point this at the production OSM API.
OSM_DEV_TOKEN=

# --- Fixtures / live-call budget ------------------------------------------
# replay  (default) never touches the network; unknown requests raise, so only
#         the five recorded demo locations work.
# record  replays known requests, goes live for new ones, writes the fixture.
# live    always goes live. THIS IS WHAT YOU WANT for arbitrary locations.
MEANDER_FIXTURES=replay

# Lifetime caps on live calls per service, enforced in fixtures.py. The defaults
# are development guard rails — 80 GraphHopper calls is roughly 26 route
# requests, after which every new location returns "no fixture for that
# request". Raise them out of the way to run the app for real; the daily
# ceiling below is what actually protects your quota, and it resets each day.
MEANDER_BUDGET_GRAPHHOPPER=100000
MEANDER_BUDGET_OVERPASS=100000
MEANDER_BUDGET_OPEN_METEO=100000
MEANDER_BUDGET_NOMINATIM=100000
MEANDER_BUDGET_MAPILLARY=100000

# --- Deployment -----------------------------------------------------------
# Comma-separated. localhost:5173 is always allowed in addition to these.
MEANDER_ALLOWED_ORIGINS=

# Refuse to boot when a required key is missing. Set to 1 in production.
MEANDER_STRICT_STARTUP=0

# Rate limiting. Defaults keep the daily ceiling under the GraphHopper quota.
MEANDER_RATE_CAPACITY=12
MEANDER_RATE_REFILL_PER_MIN=3
MEANDER_DAILY_ROUTE_CEILING=120
MEANDER_ROUTE_CACHE_TTL_S=21600

# DEBUG | INFO | WARNING | ERROR
MEANDER_LOG_LEVEL=INFO
