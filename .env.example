# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# The backend fails fast at startup with a named-key error if a required key is
# missing and MEANDER_STRICT_STARTUP=1.

# --- Routing endpoint -----------------------------------------------------
# Leave unset to use the hosted GraphHopper API. Point it at a server you run
# yourself to unlock the nature and accessible presets, which need custom
# models — a paid feature of the hosted API. See BLOCKED.md #0 and
# scripts/graphhopper.sh.
# MEANDER_GRAPHHOPPER_URL=http://localhost:8989/route

# Is that server one you run yourself? 1 or 0.
#
# **Set this explicitly in any deployment.** Unset, it is guessed from the
# hostname, which is correct on a laptop (localhost, 127.0.0.1, *.local) and
# wrong the moment the router lives behind a real name — a private ALB, ECS
# Service Connect, graphhopper.meander.internal, a VPC address.
#
# A wrong answer has no error message. It drops `smoothness` from the requested
# path details, so the accessible preset silently stops excluding surfaces
# recorded as IMPASSABLE — one of the five hard accessibility constraints stops
# firing and the app keeps answering. It also fails fastest round trips against
# a CH-prepared server, refuses to boot under MEANDER_STRICT_STARTUP, and
# changes how hard the nature preset searches, i.e. which route you get.
#
# /api/health reports both the resolved value and whether it came from this
# variable or from a guess.
# MEANDER_GRAPHHOPPER_SELF_HOSTED=1

# --- Required for live routing -------------------------------------------
# https://www.graphhopper.com/  ->  Dashboard  ->  API keys
# Free tier: 500 credits/day. One /api/routes request costs roughly 3 credits.
GRAPHHOPPER_KEY=

# --- Required for CLIP scenery scoring (offline batch job only) -----------
# https://www.mapillary.com/dashboard/developers  ->  create a client token
MAPILLARY_TOKEN=

# --- Optional: route narration -------------------------------------------
# https://console.anthropic.com/  ->  API keys. Costs real money per call.
# Absent -> narration is null and the app degrades silently.
ANTHROPIC_API_KEY=

# --- Optional: barrier reporting -----------------------------------------
# OAuth 2.0 token for api06.dev.openstreetmap.org ONLY — the OSM *development*
# server. Never point this at the production OSM API.
OSM_DEV_TOKEN=

# --- Fixtures / live-call budget ------------------------------------------
# replay  (default) never touches the network; unknown requests raise, so only
#         the five recorded demo locations work.
# record  replays known requests, goes live for new ones, writes the fixture.
# live    always goes live. THIS IS WHAT YOU WANT for arbitrary locations.
MEANDER_FIXTURES=replay

# Lifetime caps on live calls per service, enforced in fixtures.py. The defaults
# are development guard rails — 80 GraphHopper calls is roughly 26 route
# requests, after which every new location returns "no fixture for that
# request". Raise them out of the way to run the app for real; the daily
# ceiling below is what actually protects your quota, and it resets each day.
MEANDER_BUDGET_GRAPHHOPPER=100000
MEANDER_BUDGET_OVERPASS=100000
MEANDER_BUDGET_OPEN_METEO=100000
MEANDER_BUDGET_NOMINATIM=100000
MEANDER_BUDGET_MAPILLARY=100000

# --- Deployment -----------------------------------------------------------
# Comma-separated, and an exact-string allowlist: no wildcards, no subdomain
# matching, no trailing slash. "https://example.pages.dev" and
# "https://example.pages.dev/" are two different origins to a browser.
#
# localhost:5173 is NOT always allowed in addition to these — that used to be
# true and is the single most misleading line this file has had. It is added
# only in development, which the API infers from MEANDER_FIXTURES: replay and
# record are a laptop, live is not. See MEANDER_ALLOW_LOCAL_ORIGINS below.
#
# Leaving this empty in live mode means every cross-origin request is refused.
# That is deliberate: a deployment that forgot to configure CORS should fail
# loudly, not quietly allowlist somebody's dev server.
MEANDER_ALLOWED_ORIGINS=

# Force the dev-server origins on or off, overriding the rule above in either
# direction. Set it to 1 for a compose stack serving a Vite frontend against the
# real router (docker-compose.yml does), and 0 on any public host.
# Default: on only when MEANDER_FIXTURES is not live AND no origins are set.
MEANDER_ALLOW_LOCAL_ORIGINS=

# How many proxies sit in front of the API, for reading X-Forwarded-For.
#
# Getting this wrong breaks rate limiting in one of two ways, and neither is
# obvious from a log line. Too low and every client on earth resolves to the
# proxy's address and shares one 12-token bucket, so the app rate-limits itself
# into a self-DoS. Too high and a client can forge the header and get a fresh
# bucket per request.
#
# 0 means the API is reached directly. Behind Caddy alone it is 1; behind
# Cloudflare and Caddy it is 2.
MEANDER_TRUSTED_PROXY_HOPS=0

# Where the SQLite cache lives. Default: data/cache.db.
#
# ⚠ Do not set this on a deployment. The committed data/cache.db carries the 146
# pre-warmed CLIP segment scores, and pointing the API somewhere else gives it
# an empty database — every route then silently drops to scoring_method
# "geometry_only" and nothing anywhere reports an error.
MEANDER_CACHE_DB=

# Refuse to boot when a *required* key is missing. Set to 1 in production.
#
# "Required" is Settings.missing_required_keys(), which is much shorter than the
# completeness list /api/health reports: only GRAPHHOPPER_KEY, and only when the
# router is not self-hosted. MAPILLARY_TOKEN and ANTHROPIC_API_KEY are optional
# at runtime — CLIP reads scores from cache.db and narration is skipped without
# a key — so neither of them will stop a boot.
MEANDER_STRICT_STARTUP=0

# --- Timeouts ---------------------------------------------------------------
# Per-request HTTP timeouts against upstreams, in seconds.
MEANDER_HTTP_TIMEOUT_S=20
MEANDER_HTTP_CONNECT_TIMEOUT_S=5

# Whole-request budget for /api/routes, in seconds. A 3-objective request that
# misses cache has been measured at 14.0 s, so this is not much headroom.
MEANDER_REQUEST_DEADLINE_S=45

# How long a shutdown waits for open SSE streams to drain before closing them.
MEANDER_DRAIN_TIMEOUT_S=20

# Comma-separated GraphHopper path details to request.
#
# Leave it unset. The default is chosen from whether the router is self-hosted:
# road_class, surface and road_environment everywhere, plus **smoothness** on a
# self-hosted graph — which is the fifth hard accessibility constraint and the
# one the hosted API cannot supply at any price. Setting this by hand is how
# smoothness goes quietly missing and impassable ways stop being excluded.
MEANDER_PATH_DETAILS=

# Rate limiting.
#
# The per-IP token bucket is the everyday limit: 12 requests, refilling at 3 a
# minute. The daily ceiling is global — every client on earth shares one counter
# — and it exists because live mode skips the per-service call budgets above,
# which leaves this as the only guard on the shared upstreams.
#
# It used to be 120, sized against the hosted GraphHopper's 500-credit day. The
# router is self-hosted now, so that number was protecting a quota that no
# longer exists — while cutting a public deployment off after 120 requests for
# everybody, until midnight UTC.
#
# 2000 is sized against the upstream that is actually binding now. Measured, for
# one uncached 3-objective request: 8 router calls (free, self-hosted), 4
# Open-Meteo, 1 Overpass. Open-Meteo's free tier is 10,000 calls/day, so it
# saturates at about 2,500 requests. The machine gives out later — 14.0 s per
# uncached request with no --workers is roughly 6,100 a day.
#
# Raise it only after checking what your own upstreams allow.
# Burst, then sustained rate per IP. 12 and 3 were incoherent together: 3/min is
# 4,320 requests a day from one address against the 2,000 global ceiling below,
# so a single IP could spend the entire day's allowance — in about eleven hours,
# 2,000 ÷ 3 ≈ 667 minutes — and leave everyone else on 429. 1/min is 1,440 a
# day, 72% of the ceiling, so the ceiling binds before any one bucket does.
MEANDER_RATE_CAPACITY=12
MEANDER_RATE_REFILL_PER_MIN=1
MEANDER_DAILY_ROUTE_CEILING=2000
MEANDER_ROUTE_CACHE_TTL_S=21600

# Place search, on a bucket of its own. These four used to share the one above,
# which had a measurable consequence: a 20-character name costs a mean of 8.6
# geocode requests, so two place names come to 17.1 against a capacity of 12 —
# the bucket was empty before the first route request was made, and that request
# was refused too, with routing copy shown under the place box.
#
# 40 holds the worst measured single name (19 requests, when every keystroke
# lands exactly on the debounce) plus a second name. 20/min refills a drained
# bucket in two minutes rather than twelve, and is 0.33 req/s per address —
# a third of Nominatim's one-per-second policy, before either cache takes its
# share. Place search never counts against MEANDER_DAILY_ROUTE_CEILING.
MEANDER_GEOCODE_RATE_CAPACITY=40
MEANDER_GEOCODE_RATE_REFILL_PER_MIN=20
# Seven days, not the route cache's six hours: a route payload embeds weather,
# daylight and air quality and goes stale as they do, and a name-to-coordinate
# mapping embeds none of them.
MEANDER_GEOCODE_CACHE_TTL_S=604800

# DEBUG | INFO | WARNING | ERROR
MEANDER_LOG_LEVEL=INFO
