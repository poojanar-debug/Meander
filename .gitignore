# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
.vite/
*.local

# Live-call budget counters (machine-local, not shared state)
fixtures/_budget.json

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Self-hosted GraphHopper: a 45 MB server JAR, multi-GB OSM extracts and the
# routing graph built from them. All reproducible from scripts/graphhopper.sh.
graphhopper/graphhopper-web-*.jar
graphhopper/data/

# SQLite side files. The database itself is committed (it carries the pre-warmed
# CLIP segment scores); these two are per-process journal state.
*.db-wal
*.db-shm

# Agent tooling scratch. Nothing the project needs lives here — in particular
# .claude/worktrees/ holds checkouts of this very repository, and committing it
# would nest the repo inside itself.
.claude/

# Staged graph for the router image build (see scripts/publish_graph.sh).
graphhopper/graph-dist/*
!graphhopper/graph-dist/.gitkeep
